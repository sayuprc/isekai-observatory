includes:
  - vendor/larastan/larastan/extension.neon

parameters:
  paths:
    - app
    - bootstrap
    - packages
    - config/valinor.php

  level: 10

rules:
  - Tools\PHPStan\Rules\TypeAliasNamingRule
  - Tools\PHPStan\Rules\ValinorWarmupRule

services:
  -
    class: Tools\PHPStan\Collectors\MapperSignatureCollector
    tags:
      - phpstan.collector
  -
    class: Tools\PHPStan\Collectors\ValinorWarmupCollector
    tags:
      - phpstan.collector
