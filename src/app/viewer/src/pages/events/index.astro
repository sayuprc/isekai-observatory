---
import EntryGroupStatus from '../../components/viewer/EntryGroupStatus';
import EntryStatus from '../../components/viewer/EntryStatus';
import EventRow from '../../components/viewer/EventRow.astro';
import FilterBar from '../../components/viewer/FilterBar';
import SectionHead from '../../components/viewer/SectionHead.astro';
import { eventContentRepository } from '../../features/events/content';
import type { Event } from '../../features/events/types';
import { eventDate, eventTypeName } from '../../features/events/types';
import Layout from '../../layouts/Layout.astro';

const { undated, byYear } = await eventContentRepository.grouped();
const groups = [
  ...(undated.length > 0 ? [{ label: '日付未定', isYear: false, events: undated }] : []),
  ...byYear.map(({ year, events }) => ({ label: year, isYear: true, events })),
];
const total = groups.reduce((sum, group) => sum + group.events.length, 0);

const searchText = (event: Event) =>
  [event.title, eventTypeName(event.typeValue), eventDate(event) ?? '', ...event.venues.map(venue => venue.name)]
    .join(' ')
    .toLowerCase();
---

<Layout pageTitle="イベント" pageDescription="ヰ世界情緒のライブ、配信、個展などのイベント記録">
  <section class="shell page-section">
    <SectionHead title="イベント" level={1} />

    <FilterBar
      client:idle
      filters={[
        { value: 'all', label: 'すべて' },
        { value: '1', label: 'ライブ' },
        { value: '2', label: '配信' },
        { value: '3', label: '個展' },
        { value: '99', label: 'その他' },
      ]}
      entrySelector="[data-event-entry]"
      categoryAttrs={['eventType']}
      searchAttr="eventSearch"
      searchPlaceholder="タイトル・年・開催先を検索..."
    />

    <EntryStatus
      client:idle
      entrySelector="[data-event-entry]"
      emptySelector="[data-event-empty]"
      initialCount={total}
    />

    <EntryGroupStatus
      client:idle
      entrySelector="[data-event-entry]"
      groupSelector="[data-event-group]"
      countSelector="[data-event-group-count]"
      unit="件"
    />

    <div class="entry-empty entry-empty-panel" data-event-empty hidden>
      <div class="entry-empty-title">該当するイベントがありません</div>
      <div class="entry-empty-description">検索語句や種別フィルタを変えて確認してください。</div>
    </div>

    {
      groups.map(group => (
        <section class="event-group" data-event-group>
          <h2 class:list={['event-group-label', { 'event-group-label-year': group.isYear }]}>
            {group.label}
            <span class="event-group-count" data-event-group-count>{group.events.length}件</span>
          </h2>
          <ol class="event-group-list">
            {
              group.events.map(event => (
                <li
                  data-event-entry
                  data-event-type={String(event.typeValue)}
                  data-event-search={searchText(event)}
                >
                  <EventRow event={event} />
                </li>
              ))
            }
          </ol>
        </section>
      ))
    }
  </section>
</Layout>
