---
import EventDetailContent from '../../components/viewer/details/EventDetailContent.astro';
import { eventContentRepository } from '../../features/events/content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return (await eventContentRepository.all()).map((event) => ({
    params: { eventId: event.eventId },
    props: { event },
  }));
}

const { event } = Astro.props;
const pageDescription = event.description || `ヰ世界情緒のイベント「${event.title}」の記録`;
---

<Layout
  pageTitle={event.title}
  pageDescription={pageDescription}
  breadcrumbs={[
    { label: 'イベント', href: '/events' },
    { label: event.title, href: null },
  ]}
>
  <section class="shell page-section detail-page">
    <EventDetailContent event={event} />
  </section>
</Layout>
