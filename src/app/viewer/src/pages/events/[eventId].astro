---
import { eventContentRepository } from '../../features/events/content';
import { eventDate, eventStatusName, eventTypeName } from '../../features/events/types';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return (await eventContentRepository.all()).map(event => ({ params: { eventId: event.eventId }, props: { event } }));
}

const { event } = Astro.props;
---
<Layout pageTitle={event.title} pageDescription={event.description || `${event.title}のイベント記録`} breadcrumbs={[{ label: 'イベント', href: '/events' }, { label: event.title, href: null }]}>
  <section class="shell page-section detail-page">
    <div class="eyebrow">{eventTypeName(event.typeValue)}{eventStatusName(event.statusValue) ? ` — ${eventStatusName(event.statusValue)}` : ''}</div>
    <h1 class="page-title">{event.title}</h1>
    <p>{eventDate(event) ?? '開催時期未定'}</p>
    {event.description && <p class="feature-summary">{event.description}</p>}
    {event.venues.length > 0 && <p>開催先: {event.venues.map(venue => venue.name).join('、')}</p>}
    {event.sources.length > 0 && <section class="detail-block"><h2>出典</h2><ul>{event.sources.map(source => <li><a href={source.url} rel="noreferrer">{source.displayName}</a></li>)}</ul></section>}
    {event.media.length > 0 && <section class="detail-block"><h2>関連メディア</h2><ul>{event.media.map(media => <li><a href={`/media/${media.mediaId}`}>{media.title}</a></li>)}</ul></section>}
    {event.setlist.length > 0 && <section class="detail-block"><h2>セットリスト</h2><ol>{event.setlist.map(item => <li>{item.label ?? item.performances.map(performance => performance.songTitle).join(' / ')}</li>)}</ol></section>}
    {event.performances.length > 0 && <section class="detail-block"><h2>楽曲披露</h2><ul>{event.performances.map(performance => <li>{performance.songId ? <a href={`/songs/${performance.songId}`}>{performance.songTitle}</a> : performance.songTitle}{performance.coVocalists.length > 0 && <span>（共演: {performance.coVocalists.map(person => person.creditName ?? person.name).join(' / ')}）</span>}</li>)}</ul></section>}
  </section>
</Layout>
