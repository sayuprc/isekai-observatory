---
import EntryGroupStatus from '../../components/viewer/EntryGroupStatus';
import EntryStatus from '../../components/viewer/EntryStatus';
import FilterBar from '../../components/viewer/FilterBar';
import SectionHead from '../../components/viewer/SectionHead.astro';
import { releaseGroupContentRepository } from '../../features/releases/content';
import {
  RELEASE_GROUP_TYPE_FILTER_ORDER,
  RELEASE_GROUP_TYPE_NAMES,
  trackSearchTitles,
  releaseFormatText,
} from '../../features/releases/types';
import { collectTags, tagIdsText, tagNames } from '../../features/tags/tags';
import Layout from '../../layouts/Layout.astro';
import { dottedDate } from '../../shared/date';

// API は最古発売日の降順で返すので、年の区切りを入れるだけで並べ替えは不要
const releaseGroups = await releaseGroupContentRepository.all();

const tags = collectTags(releaseGroups);
const years = [...new Set(releaseGroups.map((releaseGroup) => releaseGroup.firstReleasedOn.slice(0, 4)))];
---

<Layout pageTitle="リリース" pageDescription="ヰ世界情緒のリリース一覧。アルバム・シングルなどを記録しています">
  <section class="shell page-section">
    <SectionHead title="リリース" level={1} />

    <FilterBar
      client:idle
      filters={[
        { value: 'all', label: `すべて` },
        ...RELEASE_GROUP_TYPE_FILTER_ORDER.map((value) => ({
          value: String(value),
          label: RELEASE_GROUP_TYPE_NAMES[value],
        })),
      ]}
      entrySelector="[data-release-entry]"
      categoryAttrs={['releaseType']}
      searchAttr="releaseSearch"
      searchPlaceholder="タイトル・種別・収録曲・タグを検索..."
      tags={tags}
      tagAttr="releaseTags"
    />

    <EntryStatus
      client:idle
      entrySelector="[data-release-entry]"
      emptySelector="[data-release-empty]"
      initialCount={releaseGroups.length}
    />

    <EntryGroupStatus
      client:idle
      entrySelector="[data-release-entry]"
      groupSelector="[data-release-year]"
      countSelector="[data-release-year-count]"
      unit="作品"
    />

    <div class="entry-empty entry-empty-panel" data-release-empty hidden>
      <div class="entry-empty-title">該当するリリースがありません</div>
      <div class="entry-empty-description">検索語句や種別・タグのフィルタを変えて確認してください。</div>
    </div>

    {years.map((year) => {
      const items = releaseGroups.filter((releaseGroup) => releaseGroup.firstReleasedOn.startsWith(year));

      return (
        <section class="release-year" data-release-year>
          <div class="release-year-head">
            <div class="release-year-num">{year}</div>
            <div class="release-year-count" data-release-year-count>
              {items.length}作品
            </div>
          </div>
          <ol class="release-year-list">
            {items.map((releaseGroup) => {
              const trackTitles = releaseGroup.releases.flatMap((release) =>
                release.media.flatMap((medium) => medium.tracks.flatMap(trackSearchTitles)),
              );
              const formats = [...new Set(releaseGroup.releases.flatMap((release) => release.formats))];

              return (
                <li
                  data-release-entry
                  data-release-type={String(releaseGroup.type)}
                  data-release-search={[
                    releaseGroup.title,
                    RELEASE_GROUP_TYPE_NAMES[releaseGroup.type],
                    ...trackTitles,
                    ...tagNames(releaseGroup),
                  ]
                    .join(' ')
                    .toLowerCase()}
                  data-release-tags={tagIdsText(releaseGroup)}
                >
                  <a href={`/releases/${releaseGroup.releaseGroupId}`} class="release-row">
                    <span class="label-mono release-row-date">{dottedDate(releaseGroup.firstReleasedOn.slice(5))}</span>
                    <span class="release-row-body">
                      <span class="release-row-title">{releaseGroup.title}</span>
                      <span class="release-row-meta">
                        <span class="pill" data-release-type={String(releaseGroup.type)}>
                          {RELEASE_GROUP_TYPE_NAMES[releaseGroup.type]}
                        </span>
                        {formats.length > 0 && <span>{releaseFormatText(formats)}</span>}
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      );
    })}
  </section>
</Layout>
