---
import { Q } from '../../data/mock/site-data';
import { mediaTypeLabel } from '../../features/media/labels';

interface Props {
  entry: {
    id: string;
    type: string;
    platform?: string;
    date: string;
    title?: string;
    text?: string;
    likes?: string;
    reposts?: string;
    readTime?: string;
    hasImage?: boolean;
    color: string;
  };
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const songs = Q.songsOfMedia(entry.id);

const platformMeta = {
  x: { mark: '𝕏', className: 'platform-badge-x' },
  ig: { mark: '◉', className: 'platform-badge-ig' },
  yt: { mark: '▶', className: 'platform-badge-yt' },
  blog: { mark: '¶', className: 'platform-badge-blog' },
} as const;

const platform = platformMeta[entry.platform as keyof typeof platformMeta] ?? platformMeta.blog;
---

<a href={`/media/${entry.id}`} class={`post-card ${compact ? 'post-card-compact' : ''}`}>
  <div class="post-card-head">
    <span class={`platform-badge ${platform.className}`}>{platform.mark}</span>
    <span class="label-mono">{mediaTypeLabel(entry.type)} · {entry.date}</span>
  </div>
  {entry.title && <div class="post-card-title">{entry.title}</div>}
  <div class="post-card-text">{entry.text}</div>
  {entry.hasImage && <div class="post-card-image" style={`--tile-color:${entry.color};`} />}
  {
    songs.length > 0 && (
      <div class="media-card-tags">
        {songs.map(song => <span class="pill">♪ {song.title}</span>)}
      </div>
    )
  }
  <div class="post-card-stats">
    {entry.likes && <span>♥ {entry.likes}</span>}
    {entry.reposts && <span>↻ {entry.reposts}</span>}
    {entry.readTime && <span>⏱ {entry.readTime}</span>}
  </div>
</a>
