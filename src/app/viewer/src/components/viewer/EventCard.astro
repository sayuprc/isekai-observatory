---
import type { Event } from '../../features/events/types';
import { eventShortDate, eventStatusName, eventTypeName } from '../../features/events/types';

interface Props {
  event: Event;
  withYear: boolean;
  upcoming?: boolean;
}

const { event, withYear, upcoming = false } = Astro.props;
const statusName = eventStatusName(event.statusValue);
const venueNames = event.venues.map(venue => venue.name).join('・');
---

<a
  href={`/events/${event.eventId}`}
  class="event-row"
  data-upcoming={upcoming ? '' : undefined}
  data-inactive={statusName ? '' : undefined}
>
  <span class="label-mono event-row-date">{eventShortDate(event, withYear)}</span>
  <span class="event-row-badges">
    {statusName && <span class="event-row-status">{statusName}</span>}
    <span class="event-row-type">{eventTypeName(event.typeValue)}</span>
  </span>
  <span class="event-row-title">{event.title}</span>
  {venueNames && <span class="event-row-venue">{venueNames}</span>}
</a>
