---
import type { Event } from '../../../features/events/types';
import { eventDetailDate, eventStatusName } from '../../../features/events/types';
import DetailSectionHead from './DetailSectionHead.astro';
import EventSetlistSongs from './EventSetlistSongs.astro';
import MediaChip from './MediaChip.astro';

interface Props {
  event: Event;
}

type Performance = Event['performances'][number];

const { event } = Astro.props;
const statusName = eventStatusName(event.status);
// 種別は見出しのバッジに出すので、開催情報には開催時期と開催先だけを並べる
// 期間の開始日と終了日は、それぞれ途中で折り返さないよう分けて持つ
const facts = [
  { label: '開催時期', parts: eventDetailDate(event) ?? ['開催時期未定'], separator: ' 〜 ' },
  { label: '開催先', parts: [event.venues.map(venue => venue.name).join(' / ') || '-'], separator: '' },
];

const coVocalistText = (performance: Performance): string | null =>
  performance.coVocalists.length > 0
    ? `共演: ${performance.coVocalists.map(person => person.creditName ?? person.name).join(' / ')}`
    : null;
const toSong = (performance: Performance) => ({
  title: performance.songTitle,
  href: performance.songId ? `/songs/${performance.songId}` : null,
  note: coVocalistText(performance),
});

// セットリストの項目に楽曲披露を入れ込み、どの項目からも参照されない披露だけを別に出す
const setlistItems = event.setlist.map(item => ({
  index: String(item.orderNo).padStart(2, '0'),
  label: item.label,
  songs: item.performances.map(toSong),
}));
const referencedIds = new Set(event.setlist.flatMap(item => item.performances.map(p => p.performanceId)));
const looseSongs = event.performances.filter(p => !referencedIds.has(p.performanceId)).map(toSong);
const looseTitle = setlistItems.length > 0 ? 'セットリスト外の楽曲披露' : '楽曲披露';

const hostname = (url: string): string => {
  try {
    return new URL(url).hostname;
  } catch {
    return url;
  }
};
---

<div class="detail-page-content event-detail-content" data-share-title={event.title}>
  <div class="event-detail-meta">
    <span class="label-mono">{event.type.name}</span>
    {statusName && <span class="event-detail-status">{statusName}</span>}
  </div>
  <h1 class="detail-title">{event.title}</h1>
  {event.description && <p class="detail-description event-detail-description">{event.description}</p>}

  <dl class="event-detail-facts">
    {
      facts.map(fact => (
        <div class="event-detail-fact">
          <dt class="event-detail-fact-label">{fact.label}</dt>
          <dd class="event-detail-fact-value">
            {fact.parts.map((part, index) => (
              <>
                {index > 0 && fact.separator}
                <span class="event-detail-fact-part">{part}</span>
              </>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>

  {
    setlistItems.length > 0 && (
      <>
        <DetailSectionHead title="セットリスト" count={setlistItems.length} />
        <ol class="event-setlist">
          {
            setlistItems.map(item => (
              <li class="event-setlist-item" data-label-only={item.songs.length === 0 ? '' : undefined}>
                <span class="detail-index">{item.index}</span>
                <div class="event-setlist-body">
                  {item.label && <div class="event-setlist-label">{item.label}</div>}
                  {item.songs.length > 0 && <EventSetlistSongs songs={item.songs} />}
                </div>
              </li>
            ))
          }
        </ol>
      </>
    )
  }

  {
    looseSongs.length > 0 && (
      <>
        <DetailSectionHead title={looseTitle} count={looseSongs.length} />
        <div class="event-setlist">
          <div class="event-setlist-item event-setlist-item-loose">
            <EventSetlistSongs songs={looseSongs} />
          </div>
        </div>
      </>
    )
  }

  {
    event.media.length > 0 && (
      <>
        <DetailSectionHead title="関連メディア" count={event.media.length} />
        <div class="rel-list">
          {event.media.map(media => <MediaChip media={media} />)}
        </div>
      </>
    )
  }

  {
    event.sources.length > 0 && (
      <>
        <DetailSectionHead title="出典" count={event.sources.length} />
        <div class="rel-list">
          {
            event.sources.map(source => (
              <a class="rel-chip" href={source.url} target="_blank" rel="noopener noreferrer">
                <div class="rel-copy">
                  <div class="rel-main">{source.displayName}</div>
                  <div class="label-mono rel-sub">{hostname(source.url)}</div>
                </div>
                <span class="rel-arrow rel-arrow-muted">↗</span>
              </a>
            ))
          }
        </div>
      </>
    )
  }
</div>
