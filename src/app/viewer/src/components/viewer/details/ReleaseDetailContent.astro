---
import { RELEASE_GROUP_TYPE_NAMES, releaseFormatText, type ReleaseGroup } from '../../../features/releases/types';
import { dottedDate } from '../../../shared/date';
import ReleaseVersionBody from './ReleaseVersionBody.astro';
import TagChips from './TagChips.astro';

interface Props {
  releaseGroup: ReleaseGroup;
}

const { releaseGroup } = Astro.props;
const isSingleReleaseGroup = releaseGroup.releases.length === 1;
---

<div class="detail-page-content release-detail-content" data-share-title={releaseGroup.title}>
  <div class="meta-row">
    <span class="pill" data-release-type={String(releaseGroup.type)}>
      {RELEASE_GROUP_TYPE_NAMES[releaseGroup.type]}
    </span>
  </div>
  <h1 class="detail-title">{releaseGroup.title}</h1>
  {releaseGroup.description && (
    <p class="detail-description" style="margin-top: 16px;">
      {releaseGroup.description}
    </p>
  )}
  <TagChips tags={releaseGroup.tags} />

  <div
    class:list={['release-versions', isSingleReleaseGroup && 'release-versions-single']}
    role={isSingleReleaseGroup ? undefined : 'radiogroup'}
    aria-label={isSingleReleaseGroup ? undefined : '版'}
  >
    {releaseGroup.releases.map((release, index) => {
      const tabId = `release-version-${releaseGroup.releaseGroupId}-${index}`;
      const formats = releaseFormatText(release.formats);

      return (
        <section class="release-version">
          {!isSingleReleaseGroup && (
            <>
              <input
                class="release-version-radio"
                type="radio"
                name={`release-version-${releaseGroup.releaseGroupId}`}
                id={tabId}
                checked={index === 0}
              />
              <label class="release-version-tab" for={tabId}>
                {release.name !== '' ? release.name : formats}
              </label>
            </>
          )}
          <div class="release-version-panel">
            <div class="release-version-info">
              <span class="label-mono">{dottedDate(release.releasedOn)}</span>
              <span class="label-mono">{formats}</span>
            </div>
            <ReleaseVersionBody release={release} />
          </div>
        </section>
      );
    })}
  </div>
</div>
