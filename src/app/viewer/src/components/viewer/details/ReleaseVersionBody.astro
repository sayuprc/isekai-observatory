---
import { trackSongListItem, type Release } from '../../../features/releases/types';
import DetailSongList from './DetailSongList.astro';

interface Props {
  release: Release;
}

const { release } = Astro.props;
---

<div class="release-version-content">
  <div class="release-version-track-list">
    {release.description && <p class="detail-description release-version-description">{release.description}</p>}
    {release.media.map((medium) => (
      <div class="release-medium">
        {release.media.length > 1 && (
          <div class="label-mono release-medium-heading">
            DISC {medium.position}
            {medium.name !== null ? ` · ${medium.name}` : ''}
          </div>
        )}
        {medium.tracks.length > 0 ? (
          <DetailSongList items={medium.tracks.map(trackSongListItem)} />
        ) : (
          <p class="detail-description">収録曲情報はありません。</p>
        )}
      </div>
    ))}
  </div>
</div>
