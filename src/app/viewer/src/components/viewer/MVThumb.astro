---
interface Props {
  color: string;
  label?: string;
}

const { color, label = '' } = Astro.props;
---

<div class="mv-thumb" style={`--tile-color:${color};`}>
  {label && <div class="mv-thumb-label">{label}</div>}
  <div class="mv-thumb-play" aria-hidden="true">
    <svg viewBox="0 0 24 24">
      <path d="M8 5v14l11-7z"></path>
    </svg>
  </div>
</div>
