{
  "name": "viewer",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "astro": "astro",
    "typecheck": "SKIP_CONTENT_FETCH=true astro check && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "style": "stylelint '**/*.{css,astro}' --fix",
    "style:check": "stylelint '**/*.{css,astro}'",
    "generate:api": "openapi-ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "catalog:astro",
    "@astrojs/solid-js": "catalog:astro",
    "@fontsource/eb-garamond": "catalog:fonts",
    "@fontsource/jetbrains-mono": "catalog:fonts",
    "@fontsource/noto-serif-jp": "catalog:fonts",
    "@fontsource/shippori-mincho": "catalog:fonts",
    "@fontsource/spectral": "catalog:fonts",
    "astro": "catalog:astro",
    "solid-js": "catalog:astro",
    "wrangler": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:astro",
    "@eslint/js": "catalog:lint",
    "@hey-api/openapi-ts": "catalog:gen",
    "@types/bun": "catalog:",
    "@typescript-eslint/parser": "catalog:lint",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "eslint-plugin-astro": "catalog:lint",
    "eslint-plugin-import-x": "catalog:lint",
    "postcss-html": "catalog:lint",
    "prettier": "catalog:lint",
    "prettier-plugin-astro": "catalog:lint",
    "stylelint": "catalog:lint",
    "stylelint-config-html": "catalog:lint",
    "stylelint-config-recess-order": "catalog:lint",
    "stylelint-config-standard": "catalog:lint",
    "stylelint-order": "catalog:lint",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:lint"
  }
}
