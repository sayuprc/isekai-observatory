{
  "name": "public-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshot": "node --env-file-if-exists=.env src/snapshot/main.ts && node --env-file-if-exists=.env src/snapshot/search-index.ts",
    "snapshot:search": "node --env-file-if-exists=.env src/snapshot/search-index.ts",
    "docs": "node --env-file-if-exists=.env src/docs/main.ts",
    "deploy": "wrangler deploy",
    "deploy:docs": "wrangler deploy --config wrangler.docs.jsonc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prettier:format": "prettier --write .",
    "prettier:format:check": "prettier --check .",
    "eslint:fix": "eslint --fix",
    "eslint:check": "eslint",
    "format": "bun run prettier:format",
    "format:check": "bun run prettier:format:check",
    "lint": "bun run eslint:fix",
    "lint:check": "bun run eslint:check"
  },
  "dependencies": {
    "@scalar/api-reference": "1.75.0",
    "minisearch": "7.2.0",
    "wrangler": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:lint",
    "@types/bun": "catalog:",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "eslint-plugin-import-x": "catalog:lint",
    "prettier": "catalog:lint",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:lint"
  }
}
