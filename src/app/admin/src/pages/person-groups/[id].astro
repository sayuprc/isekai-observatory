---
import { DetailView } from '../../components/person-group/EditableForm';
import Layout from '../../layouts/Layout.astro';

const { id } = Astro.params;

if (typeof id !== 'string') {
  throw new Error('URL が不正');
}
---

<Layout pageTitle="人物グループ詳細">
  <div>
    <DetailView personGroupId={id} client:only="solid-js" />
  </div>
</Layout>
