{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "* 9 * * 1"
  ],
  "updateNotScheduled": false,
  "packageRules": [
    {
      "description": "pnpm の minimumReleaseAge に合わせて npm 更新 PR を遅らせる",
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "パッケージマネージャーごとに non-major 更新をまとめる",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "{{manager}} non-major dependencies",
      "groupSlug": "{{manager}}-non-major",
      "groupSingleUpdates": true
    },
    {
      "description": "infra/docker/base は緊急時に docker library から取得したソースなので、取得元の版から動かさない",
      "matchFileNames": [
        "infra/docker/base/**"
      ],
      "enabled": false
    },
    {
      "description": "base-* は docker-bake.hcl の named context を指す別名で、registry のイメージではない",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "/^base-/"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "infra/docker のベースイメージは docker-bake.hcl の BASE_IMAGES に書く (ADR-0042)",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^:\"]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
